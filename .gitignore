# ===================================
# YouTube Download 專案 .gitignore
# ===================================

# ----- 依賴與建置 -----
/node_modules
/dist
/build

# ----- 日誌檔案 -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
/logs/

# ----- 作業系統產生的檔案 -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----- Python -----
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ----- 虛擬環境 -----
venv/
.venv/
ENV/
env/

# ----- 資料庫 -----
*.db
*.db-*
*.sqlite3

# ----- 敏感設定檔 -----
secrets.json
config.json
src/db/secrets/keys.json
.env
.env.local
.env.*.local

# ----- 使用者資料（不納入版控）-----
/uploads/
/transcripts/
/backup/

# ----- 測試產出 -----
/test-results/
/temp_test_outputs/
frontend_verification.png
dummy_audio.wav
run_log.txt
fake_audio.txt
ai_test_reports/
*.png
*.jpg

# ----- 下載的媒體檔案（可選擇性排除）-----
# 如果需要追蹤下載的檔案，請註解掉以下行
downloads/audio/*.m4a
downloads/audio/*.mp3
downloads/audio/*.wav
downloads/video/*.mp4
downloads/video/*.mkv
downloads/video/*.webm

# ----- AI Agent 相關 -----
/baked_envs/
/temp_build/
/jules-scratch/

# ----- 報告產出 -----
/reports/

# ----- 設定檔（模板除外）-----
circus.ini

# ----- 備份檔案 -----
*.bak
*.backup
*~

# ----- IDE 設定（可選）-----
# .vscode/
# .idea/
# *.swp
# *.swo
